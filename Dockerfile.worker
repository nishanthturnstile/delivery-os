FROM node:24.18.0-trixie-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.17.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @delivery-os/worker build
RUN pnpm --filter @delivery-os/worker deploy --prod /prod/worker --legacy

FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:af85d11ce7ef10172855a6e3649e3e8125b1b9e3ca41849ec2918036f05cb212 AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --chown=65532:65532 --from=build /prod/worker ./
USER 65532:65532
EXPOSE 8080
CMD ["node_modules/tsx/dist/cli.mjs", "src/main.ts"]
