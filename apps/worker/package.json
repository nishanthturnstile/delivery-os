{
  "name": "@delivery-os/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "WORKER_HOST=127.0.0.1 PORT=58080 tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@delivery-os/application": "workspace:*",
    "@delivery-os/contracts": "workspace:*",
    "@delivery-os/database": "workspace:*",
    "@delivery-os/observability": "workspace:*",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "resend": "catalog:",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "6.0.3"
  }
}
