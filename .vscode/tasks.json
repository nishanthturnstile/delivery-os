{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Delivery OS: infrastructure",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "-d",
        "--wait",
        "--wait-timeout",
        "120",
        "postgres",
        "redis",
        "minio",
        "mailpit",
        "clamav"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Delivery OS: initialize object storage",
      "type": "process",
      "command": "docker",
      "args": ["compose", "run", "--rm", "minio-init"],
      "dependsOn": ["Delivery OS: infrastructure"],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Delivery OS: prepare runtime",
      "type": "process",
      "command": "pnpm",
      "args": ["db:migrate"],
      "dependsOn": ["Delivery OS: initialize object storage"],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
