{
  "name": "delivery-os",
  "version": "0.0.0",
  "private": true,
  "description": "Delivery OS modular monolith",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0 <25",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && node scripts/check-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:migrations": "vitest run tests/migrations",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:dependencies && pnpm check:docs && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @delivery-os/database db:generate",
    "db:migrate": "pnpm --filter @delivery-os/database db:migrate",
    "worker": "pnpm --filter @delivery-os/worker start",
    "web": "pnpm --filter @delivery-os/web dev"
  },
  "devDependencies": {
    "@delivery-os/application": "workspace:*",
    "@delivery-os/contracts": "workspace:*",
    "@delivery-os/database": "workspace:*",
    "@eslint/js": "9.39.5",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@testing-library/jest-dom": "7.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-import-x": "4.17.1",
    "drizzle-orm": "0.45.2",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "pg": "8.22.0",
    "turbo": "2.10.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "uuid": "14.0.1",
    "vitest": "4.1.10"
  }
}
