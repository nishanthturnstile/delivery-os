APP_ENV=local
APP_VERSION=development
NEXT_PUBLIC_APP_VERSION=development
DATABASE_URL=postgresql://delivery_os:delivery_os_local@127.0.0.1:55432/delivery_os
REDIS_URL=redis://127.0.0.1:56379
BETTER_AUTH_URL=http://127.0.0.1:53000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

STORAGE_PROVIDER=minio
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=delivery-os
S3_ACCESS_KEY_ID=delivery_os_local
S3_SECRET_ACCESS_KEY=delivery_os_local_secret
S3_FORCE_PATH_STYLE=true

EMAIL_PROVIDER=local
MAILPIT_SMTP_URL=smtp://127.0.0.1:51025
RESEND_API_KEY=
RESEND_FROM=
AUTH_EMAIL_FROM=Delivery OS <delivery-os@localhost>

OCR_INTERNAL_URL=http://127.0.0.1:58081
OCR_SERVICE_TOKEN=delivery_os_ocr_local
OCR_MODEL_VERSION=PP-StructureV3@paddleocr-3.7.0

TELEMETRY_EXPORT_ENABLED=false
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
